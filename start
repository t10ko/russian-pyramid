#!/usr/bin/env bash
# start - Launch the Russian Pyramid practice table
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

if [ ! -f "$ROOT/.venv/bin/python" ]; then
    echo "Russian Pyramid is not set up yet. Running ./setup..."
    "$ROOT/setup"
fi

exec "$ROOT/.venv/bin/python" -m russian_pyramid.cli "$@"
